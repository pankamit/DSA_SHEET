## https://leetcode.com/problems/find-the-largest-almost-missing-integer/?envType=daily-question&envId=2026-08-18
# TC - O(N)
# SC - O(N)

class Solution {
    public int largestInteger(int[] arr, int k) {
        int n = arr.length;

        HashMap<Integer,Integer> hm = new HashMap<>();

        int max = -1;
        for(int ind=0;ind<n;ind++){
            hm.put(arr[ind],hm.getOrDefault(arr[ind],0)+1);
            max = Math.max(max,arr[ind]);
        }

        if(arr.length == k){
            return max;
        }

        max = -1;
        if(k == 1){
            for(int ind=0;ind<n;ind++){
                if(hm.get(arr[ind]) == 1){
                    max = Math.max(max,arr[ind]);
                }
            }
            return max;
        }

        max = -1;        
        if(hm.get(arr[0]) == 1){
            max = arr[0];
        }

        if(hm.get(arr[n-1]) == 1){
            max = Math.max(max,arr[n-1]);
        }


        return max;
    }
}
