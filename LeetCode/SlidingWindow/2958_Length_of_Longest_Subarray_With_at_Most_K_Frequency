## https://leetcode.com/problems/length-of-longest-subarray-with-at-most-k-frequency/?envType=daily-question&envId=2026-08-12

class Solution {
    public int maxSubarrayLength(int[] arr, int k) {
        int n = arr.length;

        int l = 0;
        int r = 0;
        int max = 0;

        HashMap<Integer,Integer> hm = new HashMap<>();

        while(r < n){
            hm.put(arr[r],hm.getOrDefault(arr[r],0)+1);
            
            int freq = hm.get(arr[r]);

            // Make it valid
            while(freq > k){
                freq = hm.get(arr[l]);
                if(freq == 1){
                    hm.remove(arr[l]);
                }else{
                    hm.put(arr[l],freq-1);
                }

                
                freq = hm.getOrDefault(arr[r],0);
                l++;
            }

            max = Math.max(max,r-l+1);

            r++;
        }

        return max;   

    }
}
