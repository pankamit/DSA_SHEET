## https://leetcode.com/problems/maximum-nesting-depth-of-two-valid-parentheses-strings/?envType=daily-question&envId=2026-09-30
# TC : O(N)
# SC : O(1)

class Solution {
    public int[] maxDepthAfterSplit(String s) {
        int n = s.length();
        int[] res = new int[n];

        int cnt1 = 0;
        int cnt2 = 0;
        int max1 = 0;
        int max2 = 0;

        for(int ind=0;ind<n;ind++){
            char ch = s.charAt(ind);
            if(ch == '('){
                if(cnt1 <= cnt2){
                    cnt1++;
                    max1 = Math.max(max1,cnt1);
                    res[ind] = 0;
                }else{
                    cnt2++;
                    max2 = Math.max(max2,cnt2);
                    res[ind] = 1;
                }
            }else{
                if(cnt1 >= cnt2){
                    cnt1--;
                    res[ind] = 0;
                }else{
                    cnt2--;
                    res[ind] = 1;
                }
            }
        }

       // System.out.println("max1 "+max1+"max2 "+max2);

        return res;

    }
}
