## https://takeuforward.org/practice/dsa/print-the-matrix-in-spiral-manner?source=planly&planly_plan=dsa-preparation&planly_task_id=24465188&planly_day_id=3053058&subject=array
# TC : O(N*M)
# SC : O(1)

class Solution {
    public List<Integer> spiralOrder(int[][] mat) {
        int n = mat.length;
        int m = mat[0].length;

        int top = 0;
        int bottom = n-1;
        int left = 0;
        int right = m-1;

        List<Integer> lst = new ArrayList<>();

        while(top <= bottom && left <= right){
            for(int j=left;j<=right;j++){
                lst.add(mat[top][j]);
            }
            top++;

            for(int i=top;i<=bottom;i++){
                lst.add(mat[i][right]);
            }
            right--;

            if(top <= bottom && left <= right){
                for(int j=right;j>=left;j--){
                    lst.add(mat[bottom][j]);
                }
                bottom--;

                for(int i=bottom;i>=top;i--){
                    lst.add(mat[i][left]);
                }
                left++;
            }

        }

        return lst;
        
    }
}
