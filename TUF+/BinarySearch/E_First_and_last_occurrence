## https://takeuforward.org/plus/dsa/problems/first-and-last-occurrence?subject=dsa&approach=using-bounds
# TC - O(logN)
# SC - O(1)    

class Solution {
    public int[] searchRange(int[] arr, int x) {
        int n = arr.length;

       // Lower Bound => smallest Index >= x
       // Uper bound => smallest Index > x 
        

        int[] resArr = new int[]{-1,-1};

        int firstIndex = findLB(arr,n,x);
        if(firstIndex == n || arr[firstIndex] != x){
            return resArr;
        }

        resArr[0] = firstIndex;

        int greaterIndex = findUB(arr,n,x,firstIndex);
        resArr[1] = greaterIndex-1;

        return resArr;

    }

    int findLB(int[] arr,int n,int x){
        int l = 0;
        int r = n-1;

        int res = n;

        while(l <= r){
            int mid = (l+r)/2;

            if(x <= arr[mid]){
                res = mid;
                r = mid-1;
            }else{
                l = mid+1;
            }
        }

        return res;
    }

    int  findUB(int[] arr,int n,int x,int firstIndex){
        
        int l = firstIndex;
        int r = n-1;

        int res = n;
        while(l <= r){
            int mid = (l+r)/2;

            if(x < arr[mid]){
                res = mid;
                r = mid-1;
            }else{
                l = mid +1;
            }
        }

        return res;
    }
}
