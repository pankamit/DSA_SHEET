## https://leetcode.com/problems/find-two-non-overlapping-sub-arrays-each-with-target-sum/?envType=daily-question&envId=2026-09-17
# TC : O(N)
# SC : O(N)

class Solution {
    public int minSumOfLengths(int[] arr, int x) {
        int n = arr.length;
        int[] lArr = new int[n];

        HashMap<Integer,Integer> hm = new HashMap<>();
        
        int sum = 0;
        hm.put(0,-1);

        int min = Integer.MAX_VALUE;
        for(int r=0;r<n;r++){
            sum += arr[r];

            int diff = sum-x;
            if(hm.containsKey(diff)){
                int l = hm.get(diff);

                int len = r-l;

                System.out.println("r "+r+" l "+l+" len "+len);            
                if(l >= 0 && lArr[l] > 0){
                    min = Math.min(min,lArr[l]+len);
                }

                if(r == 0 || lArr[r-1] == 0 || lArr[r-1] > len){
                    lArr[r] = len;
                }else{
                    lArr[r] = lArr[r-1];
                }

            }else{
                if(r > 0){
                    lArr[r] = lArr[r-1];
                }
            } 

            hm.put(sum,r);
           // System.out.println("hm "+hm+" sum "+sum+" r "+r+" lArr[r] "+lArr[r]);

        }

        //System.out.println("lArr "+Arrays.toString(lArr));
        return (min == Integer.MAX_VALUE) ? -1 : min;

    }
}
