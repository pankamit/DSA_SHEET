## https://leetcode.com/problems/distribute-elements-into-two-arrays-i/?envType=daily-question&envId=2026-08-20
# TC : O(N)
# SC : O(N)

class Solution {
    public int[] resultArray(int[] arr) {
        int n = arr.length;

        if(n <= 2){
            return arr;
        }

        List<Integer> lst1 = new ArrayList<>();
        List<Integer> lst2 = new ArrayList<>();

        lst1.add(arr[0]);
        lst2.add(arr[1]);

        for(int ind=2;ind<n;ind++){
            int last1 = lst1.get(lst1.size()-1);
            int last2 = lst2.get(lst2.size()-1);

            if(last1 > last2){
                lst1.add(arr[ind]);
            }else{
                lst2.add(arr[ind]);
            }
        
        }


        int pos = 0;
        for(int ele: lst1){
            arr[pos] = ele;
            pos++;
        }

        for(int ele: lst2){
            arr[pos] = ele;
            pos++;
        }

        return arr;

    }
}
