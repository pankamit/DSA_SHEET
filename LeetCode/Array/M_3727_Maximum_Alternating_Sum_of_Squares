## https://leetcode.com/problems/maximum-alternating-sum-of-squares/?envType=daily-question&envId=2026-10-13
# TC : O(N*logN)
# SC : O(1)

class Solution {
    public long maxAlternatingSum(int[] arr) {
        int n = arr.length;

        long sum = 0;
        for(int ind=0;ind<n;ind++){
            arr[ind] = arr[ind]*arr[ind];
        }

        Arrays.sort(arr);

        int div = n/2;
        for(int ind=0;ind<div;ind++){
            sum -= arr[ind];
        }
        for(int ind=div;ind<n;ind++){
            sum += arr[ind];
        }

        return sum;
    }
}
