## https://takeuforward.org/plus/dsa/problems/partition-equal-subset-sum?subject=dsa&approach=optimal
# TC : O(N*S) where N - no of element, S - (totoal sum)/2
# SC : O(N*S)

class Solution {
    public boolean equalPartition(int n, int[] arr) {
        
        int total = 0;
        for(int ind=0;ind<n;  ind++){
            total += arr[ind];
        }
        if(total%2 != 0){
            return false;
        }

        // int[][] memo = new int[n][total+1];
        

        total = total/2;

        // return (tr(arr,n,0,total,memo) == 2) ? true : false;

        return tr1(arr,n,total);
    }

    boolean tr1(int[] arr,int n,int sum){

        int[][] dp = new int[n+1][sum+1];

        dp[n][0] = 2;
        for(int ind=1;ind<=sum;ind++){
            //if(l == n){
                dp[n][ind] = 1;
           // }
        }

        // if(memo[l][total] != 0){
        //     return memo[l][total];
        // }

        for(int l=n-1;l>=0;l--){
            for(int total=0;total<=sum;total++){
                    
                int res1 = dp[l+1][total];
                
                int res2 = 1;
                if(total-arr[l] >= 0){
                    res2 = dp[l+1][total-arr[l]];
                }

                if(res1 == 2 || res2 == 2){
                    dp[l][total] = 2;
                }else{
                    dp[l][total] = 1;
                }

            }
        }

        return dp[0][sum] == 2 ? true : false;

    }

    int tr(int[] arr,int n,int l,int total,int[][] memo){

        if(l == n){
            return (total == 0) ? 2 : 1;
        }

        if(memo[l][total] != 0){
            return memo[l][total];
        }

        int res1 = tr(arr,n,l+1,total,memo);
        
        int res2 = 1;
        if(total-arr[l] >= 0){
            res2 = tr(arr,n,l+1,total-arr[l],memo);
        }

        if(res1 == 2 || res2 == 2){
            memo[l][total] = 2;
        }else{
            memo[l][total] = 1;
        }

        return memo[l][total];

    }
}
