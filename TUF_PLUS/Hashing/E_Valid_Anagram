## https://takeuforward.org/practice/dsa/valid-anagram?source=planly&planly_plan=dsa-preparation&planly_task_id=24465195&planly_day_id=3053061&subject=blind-75&tab=problem&solution=optimal
# TC : O(N)
# SC : O(N)

class Solution {  
    public boolean anagramStrings(String s, String t) {
        //your code goes here
        int n = s.length();
        if(t.length() != n){
            return false;
        }

        HashMap<Character,Integer> hm = new HashMap<>();
        for(int ind=0;ind<n;ind++){
            char ch1 = s.charAt(ind);
            char ch2 = t.charAt(ind);
            if(ch1 == ch2){
                continue;
            }

            hm.put(ch1,hm.getOrDefault(ch1,0)+1);
            hm.put(ch2,hm.getOrDefault(ch2,0)-1);

            if(hm.get(ch1) == 0){
                hm.remove(ch1);
            }

            if(hm.get(ch2) == 0){
                hm.remove(ch2);
            }

        }

        return hm.isEmpty();

    }
}
