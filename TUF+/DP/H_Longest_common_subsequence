## https://takeuforward.org/plus/dsa/problems/longest-common-subsequence?subject=dsa&approach=optimal
# TC : O(N*M)
# SC : O(N*M)


class Solution {
    public int lcs( String s1, String s2) {
        
        int n = s1.length();
        int m = s2.length();

        // int[][] memo = new int[n][m];
        // for(int ind=0;ind<n;ind++){
        //     Arrays.fill(memo[ind],-1);
        // }

        // return tr(s1,s2,n-1,m-1,memo);

        return  tr1(s1,s2,n,m);


    }

    int tr1(String s1,String s2,int n,int m){

        int[][] dp = new int[n][m];

        // if(l == -1 || r == -1){
        //     return 0;
        // }

        
        for(int l=0;l<n;l++){
            for(int r=0;r<m;r++){
            
                int max = (l > 0) ? dp[l-1][r] : 0;
                
                max = Math.max(max, (r > 0) ? dp[l][r-1] : 0);
        
                if(s1.charAt(l) == s2.charAt(r)){
                    max = Math.max(max,1 + ((l>0 && r>0) ? dp[l-1][r-1] : 0));
                }

                dp[l][r] = max;
            }
        }

        return dp[n-1][m-1];
        
    }

    int tr(String s1,String s2,int l,int r,int[][] memo){

        if(l == -1 || r == -1){
            return 0;
        }

        if(memo[l][r] != -1){
            return memo[l][r];
        }
        

        int max = tr(s1,s2,l-1,r,memo);
        
        max = Math.max(max,tr(s1,s2,l,r-1,memo));
 
        if(s1.charAt(l) == s2.charAt(r)){
            max = Math.max(max,1 + tr(s1,s2,l-1,r-1,memo));
        }

        memo[l][r] = max;
        return memo[l][r];

    }
}

