## https://takeuforward.org/plus/dsa/problems/minimum-days-to-make-m-bouquets?subject=dsa&approach=recursion&tab=submissions
# TC : O(N*logg(max(arr));
# SC : O(1)

class Solution {
    public int roseGarden(int n, int[] arr, int k, int m) {
            if(k*m > n){
                return -1;
            }

        int max = 0;
        for(int ind=0;ind<n;ind++){
           max = Math.max(max,arr[ind]);
        }

        int l = 1;
        int r = max;

        int res = -1;

        while(l <= r){
            int mid = l + (r-l)/2;

            if(find(arr,n,k,m,mid)){
                res = mid;
                r = mid-1;
            }else{
                l = mid+1;
            }

        }

        return res;
    }

    boolean find(int[] arr,int n,int k,int m,int x){

        int cnt = 0;

        int ccnt = 0;
        for(int ind=0;ind<n;ind++){
            if(arr[ind] <= x){
                ccnt++;

            }else{
                cnt += ccnt/k;
                ccnt=0;
            }
        }
        cnt += ccnt/k;

        if(cnt >= m){
            return true;
        }else{
            return false;
        }
    }
}


