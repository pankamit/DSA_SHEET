## https://takeuforward.org/plus/dsa/problems/find-the-smallest-divisor?subject=dsa&approach=binary-search
# TC : O(N*log(max(arr)))
# SC : O(1)

class Solution {
    public int smallestDivisor(int[] arr, int k) {
       int n = arr.length;

      int max = arr[0];
      for(int ind=1;ind<n;ind++){
        max = Math.max(max,arr[ind]);
      }

       int l = 1;
       int r = max;

       int res = max;
       while(l <= r){
        int mid = l + (r-l)/2;

        if(findDiv(arr,n,mid,k)){
            res = mid;
            r = mid-1;
        }else{
            l = mid+1;
        }
       }

       return res;

    }

    boolean findDiv(int[] arr,int n,int b,int k){

        long sum = 0;
        for(int ind=0;ind<n;ind++){
            sum += ((long)arr[ind]+b-1)/b;
            if(sum > (long)k){
                return false; 
            }
        }
        return true;
    }
}
