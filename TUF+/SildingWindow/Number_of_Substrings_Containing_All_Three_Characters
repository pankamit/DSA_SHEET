## https://takeuforward.org/plus/dsa/problems/number-of-substrings-containing-all-three-characters?subject=dsa&approach=optimal

class Solution {    
    public int numberOfSubstrings(String s) {
        //your code goes here
        int n = s.length();
        HashMap<Character,Integer> hm = new HashMap<>();
        hm.put('a',1);
        hm.put('b',1);
        hm.put('c',1);
    
        int cnt = 3;

        int l = 0;
        int r = 0;

        int res = 0;

        while(r < n){
            char ch = s.charAt(r);
            hm.put(ch,hm.getOrDefault(ch,0)-1);
            if(hm.get(ch) >= 0){
                cnt--;
            }

            // Make it invalid
            while(cnt == 0){
                res += (n-r);
                
                ch = s.charAt(l);
                hm.put(ch,hm.get(ch)+1);
                if(hm.get(ch) > 0){
                    cnt++;
                }
                l++;        
            }

            r++;
        }

        return res;

    }
}
