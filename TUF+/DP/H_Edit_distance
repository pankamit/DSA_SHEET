## https://takeuforward.org/plus/dsa/problems/edit-distance?subject=dsa&approach=optimal
# TC : O(N*M)
# SC : O(N*M)

class Solution {
    public int editDistance(String s, String t) {
        int n = s.length();
        int m = t.length();


        // int[][] memo = new int[n+1][m+1];
        // for(int i=0;i<=n;i++){
        //     for(int j=0;j<=m;j++){
        //         memo[i][j] = -1;
        //     }
        // }

        // return tr(s,t,n,m,memo);

        return tr1(s,t,n,m);


    }

    int tr1(String s,String t,int len1,int len2){

        int[][] dp = new int[len1+1][len2+1];

        for(int j=0;j<=len2;j++){
            dp[0][j] = j;
        }

        // if(n == 0){
        //     return m;
        // }

        for(int i=0;i<=len1;i++){
            dp[i][0] = i;
        }

        // if(m == 0){
        //     return n;
        // }

        
        for(int n=1;n<=len1;n++){
            for(int m=1;m<=len2;m++){
    
                int min = Integer.MAX_VALUE;
                if(s.charAt(n-1) == t.charAt(m-1)){
                    min = dp[n-1][m-1];
                }else{
                    min = 1+dp[n-1][m];
                    min = Math.min(min,1+dp[n][m-1]);
                    min = Math.min(min,1+dp[n-1][m-1]);
                }

                dp[n][m] = min;
            }
        }

        return dp[len1][len2];
    }

    int tr(String s,String t,int n,int m,int[][] memo){

        if(n == 0){
            return m;
        }

        if(m == 0){
            return n;
        }

        if(memo[n][m] != -1){
            return memo[n][m];
        }

        int min = Integer.MAX_VALUE;

        if(s.charAt(n-1) == t.charAt(m-1)){
           min = tr(s,t,n-1,m-1,memo);
        }else{
           min = 1+tr(s,t,n-1,m,memo);
           min = Math.min(min,1+tr(s,t,n,m-1,memo));
           min = Math.min(min,1+tr(s,t,n-1,m-1,memo));
        }

        memo[n][m] = min;
        return memo[n][m];
    }
}
