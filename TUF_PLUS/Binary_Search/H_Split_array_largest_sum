## https://takeuforward.org/practice/dsa/split-array---largest-sum?source=planly&planly_plan=dsa-preparation&planly_task_id=24465217&planly_day_id=3053074&subject=binary-search
# TC : O(N*log(sum(arr)-max(arr)))
# SC : O(1)

class Solution {
    public int largestSubarraySumMinimized(int[] arr, int k) {
        int n = arr.length;

        int sum = 0;
        int max = Integer.MIN_VALUE;
        for(int ind=0;ind<n;ind++){
            sum += arr[ind];
            max = Math.max(max,arr[ind]);
        }

        int l = max;
        int r = sum;

        int res = -1;
        while(l <= r){
            int mid = (l+r)/2;

            if(isValid(arr,n,mid,k)){
                res = mid;
                r = mid-1;
            }else{
                l = mid+1;
            }
        }

        return res;

    }

    boolean isValid(int[] arr,int n,int x,int k){
        int cnt = 0;
        int temp = 0;
        for(int ind=0;ind<n;ind++){
            temp += arr[ind];
            if(temp > x){
                cnt++;
                temp = arr[ind];
            }
        }
        cnt++;

        if(cnt <= k){
            return true;
        }
        return false;

    }
}
