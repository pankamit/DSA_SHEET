## https://leetcode.com/problems/minimum-operations-to-sort-a-string/?envType=daily-question&envId=2026-10-21
# TC : O(N)
# SC : O(1)

class Solution {
    public int minOperations(String s) {
        int n = s.length();
        
        if(isSorted(s,n)){
            return 0;
        }
        
        if(n == 2){
            return - 1;
        }

        if(isFirstSmall(s,n) || isLastBig(s,n)){
            return 1;
        }

        if(isLastSmall(s,n) && isFirstBig(s,n)){

            if(isMid(s,n,s.charAt(n-1)) || isMid(s,n,s.charAt(0))){
                return 2;
            }else{
                return 3;
            }
        }
        

        return 2;
    }

    boolean isMid(String s,int n,char ch){
        for(int ind=1;ind<n-1;ind++){
            if(s.charAt(ind) == ch){
                return true;
            }
        }

        return false;
    }



    boolean isLastSmall(String s,int n){
        char ch = s.charAt(n-1);
        for(int ind=0;ind<n-1;ind++){
            if(ch > s.charAt(ind)){
                return false;
            }
        }
        return true;
    }

    boolean isFirstBig(String s,int n){
        char ch = s.charAt(0);
        for(int ind=1;ind<n;ind++){
            if(ch < s.charAt(ind)){
                return false;
            }
        }
        return true;
    }

    boolean isFirstSmall(String s,int n){
        char ch = s.charAt(0);
        for(int ind=1;ind<n;ind++){
            if(ch > s.charAt(ind)){
                return false;
            }
        }
        return true;
    }

    boolean isLastBig(String s,int n){
        char ch = s.charAt(n-1);
        for(int ind=0;ind<n-1;ind++){
            if(ch < s.charAt(ind)){
                return false;
            }
        }
        return true;
    }

