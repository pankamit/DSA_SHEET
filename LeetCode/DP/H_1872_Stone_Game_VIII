## https://leetcode.com/problems/stone-game-viii/?envType=daily-question&envId=2026-08-25
# TC : O(N)
# SC : O(N)

class Solution {
    public int stoneGameVIII(int[] arr) {
        int n = arr.length;

        int[] pArr = new int[n];
        pArr[0] = arr[0];

        for(int ind=1;ind<n;ind++){
            pArr[ind] = pArr[ind-1] + arr[ind];
        }

        int[] memo = new int[n];
        Arrays.fill(memo,Integer.MIN_VALUE);

        return tr(pArr,n,1,memo);

    }

    int tr(int[] pArr,int n,int l,int[] memo){

        if(l == n-1){
            return pArr[l];
        }

        if(l == n){
            return 0;
        }

        if(memo[l] != Integer.MIN_VALUE){
            return memo[l];
        }

        //int max = Integer.MIN_VALUE;
 
 //       for(int ind=l;ind<n;ind++){
          int  max = Math.max(tr(pArr,n,l+1,memo), pArr[l] - tr(pArr,n,l+1,memo));
   //     }

        memo[l] = max;
        return max;

    }
}
