## https://takeuforward.org/plus/dsa/problems/cherry-pickup-ii?subject=dsa&approach=optimal

class Solution {
    public int cherryPickup(int[][] mat) {
        int n = mat.length;
        int m = mat[0].length;

        /*int[][][] memo = new int[n][m][m];
        for(int i=0;i<n;i++){
            for(int j=0;j<m;j++){
                Arrays.fill(memo[i][j],-1);
            }
        }

        return tr(mat,n,m,0,0,m-1,memo);*/

        return tr1(mat,n,m);
    }

    int tr1(int[][] mat,int n,int m){

        int[][][] dp = new int[n][m][m];

        for(int c1=0;c1<m;c1++){
            for(int c2=0;c2<m;c2++){

                int sum = mat[n-1][c1];
                if(c1 != c2){
                    sum += mat[n-1][c2];
                }

                dp[n-1][c1][c2] = sum;

            }
        }

        // if(r == n-1){
        //     return sum;
        // }

        for(int r=n-2;r>=0;r--){
            for(int c1=m-1;c1>=0;c1--){
                for(int c2=m-1;c2>=0;c2--){
                    
                    int max = 0;
                    
                    int sum = mat[r][c1];
                    if(c1 != c2){
                        sum += mat[r][c2];
                    }

                    for(int i=-1;i<=1;i++){
                        for(int j=-1;j<=1;j++){

                            if(c1+i >=0 && c1+i < m && c2+j >=0 && c2+j < m){
                                int res = sum + dp[r+1][c1+i][c2+j];
                                max = Math.max(max,res);
                            }
                        
                        }
                    }

                    dp[r][c1][c2] = max;
                }
            }
        }

        return dp[0][0][m-1];

    }

    int tr(int[][] mat,int n,int m,int r,int c1,int c2,int[][][] memo){


        int sum = mat[r][c1];
        if(c1 != c2){
            sum += mat[r][c2];
        }

        if(r == n-1){
            return sum;
        }

        if(memo[r][c1][c2] != -1){
            return memo[r][c1][c2];
        }

        int max = 0;

        for(int i=-1;i<=1;i++){
            for(int j=-1;j<=1;j++){

                if(c1+i >=0 && c1+i < m && c2+j >=0 && c2+j < m){
                    int res = sum + tr(mat,n,m,r+1,c1+i,c2+j,memo);
                    max = Math.max(max,res);
                }
            
            }
        }

        memo[r][c1][c2] = max;
        return max;

    }
}
