## https://takeuforward.org/plus/dsa/problems/koko-eating-bananas?subject=dsa&approach=recursion
# TC : O(N*log(Max(arr))
# SC : O(1)

class Solution {
    public int minimumRateToEatBananas(int[] arr, int h) {
        int n = arr.length;

        int max = Integer.MIN_VALUE;
        for(int ind=0;ind<n;ind++){
            max = Math.max(max,arr[ind]);
        }

        int l = 1;
        int r = max;



        int res = max;
        while(l <= r){
            int mid = l + (r-l)/2;

            if(isValid(arr,n,mid,h)){
                res = mid;
                r = mid-1;
            }else{
                l = mid+1;
            }
        }

        return res;

    }

    boolean isValid(int[] arr,int n,int x,int h){

        int sum = 0;
        for(int ind=0;ind<n;ind++){
           // sum += Math.ceil((double)arr[ind]/x);
            sum += (arr[ind]+x-1)/x;
            if(sum > h){
                return false;
            }
        }

        return true;

    }
}
