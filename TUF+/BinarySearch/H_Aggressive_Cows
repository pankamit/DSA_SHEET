## https://takeuforward.org/plus/dsa/problems/aggressive-cows?subject=dsa&approach=linear-search&tab=submissions

class Solution {
    public int aggressiveCows(int[] arr, int k) {
        
        int n = arr.length;

        Arrays.sort(arr);
        int l = 0;
        int r = arr[n-1]-arr[0];

        int res = -1;
        while(l <= r){
            int mid = (l+r)/2;

            if(check(arr,n,k,mid)){
                res = mid;
                l = mid+1;

            }else{
                r = mid-1;
            }
        
        
        }

        return res;

    }

    boolean check(int[] arr,int n,int k,int x){
        
        int cnt = 1;
        int prev = arr[0];

        for(int ind=1;ind<n;ind++){
            if((arr[ind] - prev) >= x){
                cnt++;
                prev = arr[ind];
            }
        }

        //System.out.println("x "+x+" cnt "+cnt+" k "+k);
        return (cnt >= k);
    }
}
