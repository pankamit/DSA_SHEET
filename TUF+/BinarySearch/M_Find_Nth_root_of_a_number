## https://takeuforward.org/plus/dsa/problems/find-nth-root-of-a-number?subject=dsa&approach=binary-search&tab=submissions
# TC : O(logN* logM)
# SC : O(1)

class Solution {
    public int NthRoot(int N, int M) {
        
        int l = 0;
        int r = M;

        while(l <= r){
            int mid = l+(r-l)/2;

            // long val = 1;
            // for(int ind=0;ind<N;ind++){
            //     val = val*mid;
            //     if(val > M){
            //         break;
            //     }
            // }

            // System.out.println("val "+val+" mid "+mid);

            int diff = findVal(mid,N,M);
            System.out.println("diff "+diff+" mid "+mid);
 
            if(diff == 1){
                return mid;
            }else if(diff == 0){
                l = mid+1;
            }else{
                r = mid-1;
            }

        }

        return -1;

    }

    int findVal(long base,int N,int M){

        long ans = 1;
     
        while(N > 0){
            if(N%2 == 1){
                ans = ans*base;
                if(ans > M){
                    return 2;
                }
                N--;

            }else{
                base = base*base;
                if(base > M){
                    return 2;
                }
                N = N/2;
            }
        }

        if(ans == M){
            return 1;
        }else if(ans > M){
            return 2;
        }else{
            return 0;
        }
    }
}
