# TC : O(N) where N -> length of the input string
# SC : O(M) where M -> total no of characters inserted for Trie 

class Trie {
Node root;
    class Node{
        Node[] nodeArr = new Node[26];
        int pc;
        int lc;

        boolean contains(char ch){
            return nodeArr[ch - 'a'] != null;
        }

        void add(char ch){
            nodeArr[ch-'a'] = new Node();
            
        }

        Node get(char ch){
            return nodeArr[ch-'a'];
        }

        void delete(char ch){
            nodeArr[ch-'a'] = null;
        }
    }   

public Trie() {
        root = new Node();
    }

    public void insert(String s) {
        Node node = root;
        for(int ind=0;ind<s.length();ind++){
            char ch = s.charAt(ind);
            if(!node.contains(ch)){
                node.add(ch);    
            } 
            node = node.get(ch);
            node.pc++;

        }
        node.lc++;        
    }

    public int countWordsEqualTo(String s) {
        Node node = root;
        for(int ind=0;ind<s.length();ind++){
            char ch = s.charAt(ind);
            if(node.contains(ch)){
                node = node.get(ch);
            }else{
                return 0;
            }
        }
        return node.lc;        
    }

    

    public int countWordsStartingWith(String s) {
        Node node = root;
        for(int ind=0;ind<s.length();ind++){
            char ch = s.charAt(ind);
            if(node.contains(ch)){
                node = node.get(ch);
            }else{
                return 0;
            }
        }
        return node.pc;
        
    }

