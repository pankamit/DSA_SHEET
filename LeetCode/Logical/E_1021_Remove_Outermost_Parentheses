## https://leetcode.com/problems/remove-outermost-parentheses/?envType=daily-question&envId=2026-10-08
# TC : O(N)
# SC : O(1)

class Solution {
    public String removeOuterParentheses(String s) {
        int n = s.length();
        int cnt = 0;

        String res = "";

        int r = 0;
        while(r < n){
            char ch = s.charAt(r);
            if(ch == '('){
                cnt++;
                if(cnt != 1){
                    res += ch;
                }
            }else{
                cnt--;
                if(cnt != 0){
                    res += ch;
                }
            }

            r++;
        }

        return res;
    }
}
