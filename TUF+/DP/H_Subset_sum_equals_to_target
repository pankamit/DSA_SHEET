## https://takeuforward.org/plus/dsa/problems/subset-sum-equals-to-target?subject=dsa&approach=memoization&tab=submissions
# TC : O(N*X)
# SC : O(N*X)

class Solution {
    public boolean isSubsetSum(int[] arr, int  x) {
        int n = arr.length;

         int[][] memo = new int[n][x+1];
         

         return tr(arr,n,0,x,memo);

//        return tr1(arr,n,x);
    }

    boolean tr1(int[] arr,int n,int tar){

      int[][] dp = new int[n+1][tar+1];
      
      for(int ind=0;ind<=n;ind++){
        dp[ind][0] = 2;
      }

      for(int ind=1;ind<=tar;ind++){
        dp[n][ind] = 1;
      }

    //    if(x == 0){
    //     return true;
    //    }

    //    if(l == n){
    //         return false;
    //    } 

      for(int l=n-1;l>=0;l--){
       for(int x=1;x<=tar;x++){
        int valid1 = dp[l+1][x];
        int valid2 = 1;
        if(x-arr[l] >= 0){
            valid2 = dp[l+1][x-arr[l]];
        }

        if(valid1==2 || valid2==2){
            dp[l][x] = 2;
        }else{
            dp[l][x] = 1;
        }
       }
      }

       return dp[0][tar] == 2? true : false;
 
    }

    boolean tr(int[] arr,int n,int l,int x,int[][] memo){
       if(x == 0){
        return true;
       }

       if(l == n){
            return false;
       } 

       if(memo[l][x] != 0){
          return memo[l][x] == 2;
       }

        boolean valid1 = tr(arr,n,l+1,x,memo);
        boolean valid2 = false;
        if(x-arr[l] >= 0){
            valid2 = tr(arr,n,l+1,x-arr[l],memo);
        
        }

        if(valid1 || valid2){
            memo[l][x] = 2;
        }else{
            memo[l][x] = 1;
        }


        return memo[l][x] == 2;
    }
}
