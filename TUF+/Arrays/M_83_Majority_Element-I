## https://takeuforward.org/practice/dsa/majority-element-i
# TC : O(N)
# SC : O(1)

class Solution {
    public int majorityElement(int[] arr) {
        int n = arr.length;

        int max = arr[0];
        int cnt = 1;

        for(int ind=1;ind<n;ind++){
            if(arr[ind] == max){
                cnt++;
            }else{

                if(cnt == 0){
                    max = arr[ind];
                    cnt++;
                }else{
                    cnt--;
                }
                
            }
        }

        return max;

    }
}
