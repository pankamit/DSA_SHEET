## https://takeuforward.org/plus/dsa/problems/search-in-rotated-sorted-array-2?subject=dsa&approach=optimal
# O(logN) and O(N) in worst case
# O(1)

class Solution {
    public boolean searchInARotatedSortedArrayII(int[] arr, int x) {
        int n = arr.length;

        int l =0;
        int r = n-1;

        while(l <= r){

            int mid = (l+r)/2;

            if(x == arr[mid]){
                return true;
            }else if(arr[l] == arr[mid] && arr[r] == arr[mid]){
                    l++;
                    r--;
                    continue;
            }else{
                if(arr[l] <= arr[mid]){
                    if(x >= arr[l] && x < arr[mid]){
                        r = mid-1;
                    }else{
                        l = mid+1;
                    }
                }else{
                    if(x > arr[mid] && x <= arr[r]){
                        l = mid+1;
                    }else{
                        r = mid-1;
                    }
                }
            }
        }

        return false;
    }
}
