## https://leetcode.com/problems/minimum-moves-to-equal-array-elements-iii/?envType=daily-question&envId=2026-11-03
# TC : O(N)
# SC : O(1)

class Solution {
    public int minMoves(int[] arr) {
        int n = arr.length;

        int max = Integer.MIN_VALUE;
        for(int ele : arr){
            max = Math.max(max,ele);
        }

        int cnt = 0;
        for(int ele : arr){
            cnt += (max-ele);
        }

        return cnt;
    }
}
