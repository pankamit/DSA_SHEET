## https://leetcode.com/problems/minimum-moves-to-equal-array-elements/?envType=daily-question&envId=2026-11-01
# TC : O(N*logN)
# SC : O(1)

class Solution {
    public int minMoves(int[] arr) {

        int n = arr.length;

        Arrays.sort(arr);

        int res = 0;
        
        int min = arr[0];
        int max = arr[n-1];
        for(int ind=1;ind<n;ind++){
            res += arr[ind]-min;
        }
        return res;
        
    }
}
