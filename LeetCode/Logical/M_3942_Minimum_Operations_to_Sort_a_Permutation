## https://leetcode.com/problems/minimum-operations-to-sort-a-permutation/?envType=daily-question&envId=2026-10-22
# TC : O(N)
# SC : O(1)

class Solution {
    public int minOperations(int[] arr) {

        int n = arr.length;

        int asc = 1;
        int dsc = 1;

        boolean ascFlag = false;
        boolean dscFlag = false;

        for(int ind=1;ind<n;ind++){
            if((arr[ind])%n == (arr[ind-1]+1)%n){
                asc++;
            }else{
                ascFlag=true;
            }
            if((arr[ind]+1)%n == (arr[ind-1])%n){
                dsc++;
            }else{
                dscFlag = true;
            }
        }

        
        if(!ascFlag){
           if(arr[0] == 0){
            return 0;
           }
           return Math.min(n-arr[0],arr[0]+2);
        }   

        if(!dscFlag){
            if(arr[n-1] == 0){
                return  1;
            }
            return Math.min(n-arr[n-1]+1,arr[n-1]+1);
        }   

        return -1; 
        
    }
}
