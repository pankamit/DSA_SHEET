## https://takeuforward.org/plus/dsa/problems/find-square-root-of-a-number?subject=dsa&approach=binary-search
# TC : O(logN)
# SC : O(1)


class Solution {
    public int floorSqrt(int n) {
      int l = 0;
      int r = n;

      int res = -1;
      while(l <= r){
        int mid = l + (r - l)/2;
        long val = (long)mid * mid;

        if(val == (long)n){
            return mid;
        }else if(val < (long)n){
            res = mid;
            l = mid+1;
        }else{
            r = mid-1;
        }
      }

      return res;
    }
}
