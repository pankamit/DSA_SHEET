## https://takeuforward.org/practice/dsa/minimum-days-to-make-m-bouquets?source=planly&planly_plan=dsa-preparation&planly_task_id=24465216&planly_day_id=3053074&subject=binary-search
# TC : O(N*log(max(arr)))
# SC : O(1)

class Solution {
    public int roseGarden(int n, int[] arr, int k, int m) {

        int max = Integer.MIN_VALUE;
        for(int ind=0;ind<n;ind++){
            max = Math.max(max,arr[ind]);
        }

        if((m*k) > n){
            return -1;
        }

        int l = 0;
        int r = max;

        int res = -1;
        while(l <= r){
            
            int mid = (l+r)/2;

            if(isValid(arr,mid,m,k)){
                res = mid;
                r = mid-1;
            
            }else{
                l = mid+1;
            }
            
        }

        return res;
     
    }

    boolean isValid(int[] arr,int x,int m,int k){
        int n = arr.length;

        int cnt = 0;
        int total = 0;
        for(int ind=0;ind<n;ind++){
            if(arr[ind] <= x){
                cnt++;
            }else{
                cnt=0;
            }
            if(cnt >= k){
                cnt = cnt-k;
                total++;
            }
        }

        if(total >= m){
            return true;
        }
        return false;
    }
}


