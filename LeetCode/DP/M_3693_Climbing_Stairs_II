## https://leetcode.com/problems/climbing-stairs-ii/?envType=daily-question&envId=2026-11-10
# TC : O(N)
# SC : O(N)

class Solution {
    public int climbStairs(int n, int[] cArr) {
        
        int[] memo = new int[n];
        Arrays.fill(memo,-1);
        return tr(cArr,n,0,memo);
    }

    int tr(int[] cArr,int n,int curr,int[] memo){

        if(curr == n){
            return 0;
        }

        if(memo[curr] != -1){
            return memo[curr];
        }

        int min = Integer.MAX_VALUE;
        for(int ind=1;ind<=3;ind++){
            int next = curr+ind;
            if(next <= n){
                int new_c = cArr[next-1]+(ind*ind);
                min = Math.min(min,new_c + tr(cArr,n,next,memo));
            }
        }

        memo[curr] = min;
        return memo[curr];
    }
}
