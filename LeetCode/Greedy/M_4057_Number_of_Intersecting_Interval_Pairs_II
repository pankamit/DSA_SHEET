## https://leetcode.com/problems/number-of-intersecting-interval-pairs-ii/
# TC : O(N*LogN)
# SC : O(1)

class Solution {
    public long countIntersectingIntervals(int[][] mat) {
        int n = mat.length;

        Arrays.sort(mat,(e1,e2) -> e1[1]-e2[1]);

        long cnt = 0;
        for(int r=1;r<n;r++){
            int start = mat[r][0];
            int end = mat[r][1];
            cnt += find(mat,r-1,start);
        }

        return cnt;
    }

    int find(int[][] mat,int r,int x){

        
        int n = r+1;
        int l = 0;

        int res = n;
        while(l <= r){
            int mid = (l+r)/2;

            if(mat[mid][1] < x){
                l = mid+1;
            }else{
                res = mid;
                r = mid-1;
            }
            
        }

       // System.out.println(" x "+x+" n "+n+" res "+res);
        return n-res;
        
    }
}
