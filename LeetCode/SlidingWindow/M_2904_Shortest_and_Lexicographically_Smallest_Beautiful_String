## https://leetcode.com/problems/shortest-and-lexicographically-smallest-beautiful-string/?envType=daily-question&envId=2026-08-26
# TC : O(N)
# SC : O(N)

class Solution {
    public String shortestBeautifulSubstring(String s, int k) {
        int n = s.length();

        char[] chArr = s.toCharArray();

        int min = Integer.MAX_VALUE;
        String minV = ""; 

        int l = 0;
        int r = 0;

        int cnt = 0;
        while(r < n){
            
            if(chArr[r] == '1'){
                cnt++;
            }

            // Make it Invalid
            while(cnt == k){
                int len = r-l+1;
                if(min > len){
                    min = len;
                    minV = s.substring(l,r+1);
                }else if(min == len){
                    minV = findMin(minV,s.substring(l,r+1));
                }
                if(chArr[l] == '1'){
                    cnt--;
                } 
                l++;
            }

            r++;
            
        }

        return minV;

    }

    String findMin(String s1,String s2){
        int n = s1.length();

        for(int ind=0;ind<n;ind++){
            if(s1.charAt(ind) < s2.charAt(ind)){
                return s1;
            }else if(s1.charAt(ind) > s2.charAt(ind)){
                return s2;
            }
        }

        return s1;
    
    }
}
