## https://takeuforward.org/plus/dsa/problems/find-peak-element?subject=dsa&approach=binary-search
# TC : O(logN)
# SC : O(1)

class Solution {
    public int findPeakElement(int[] arr) {
        int n = arr.length;
        if(n == 1){
            return 0;
        }

        if(arr[0] > arr[1]){
            return 0;
        }

        if(arr[n-2] < arr[n-1]){
            return n-1;
        }

        int l = 1;
        int r = n-2;

        while(l <= r){
            int mid = l + (r-l)/2;

            if(arr[mid-1] < arr[mid] && arr[mid] > arr[mid+1]){
                return mid;
            }

            if(arr[mid-1] > arr[mid]){
                r = mid-1;
            }else{
                l = mid+1;
            }
        }

        return -1;
    }
}
