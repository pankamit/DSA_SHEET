## https://takeuforward.org/plus/dsa/problems/floor-and-ceil-in-sorted-array?subject=dsa&approach=optimal
# TC - O(logN)
# SC - O(1)

class Solution {
    public int[] getFloorAndCeil(int[] arr, int x) {
       int  n = arr.length;

        int[] resArr = new int[2];
        resArr[0] = findFloor(arr,n,x);
        resArr[1] = findCeil(arr,n,x);

        return resArr; 
    }

    int findCeil(int[] arr,int n,int x){

        int l = 0;
        int r = n-1;

        int res = -1;
        while(l <= r){
            int mid = (l+r)/2;

            if(x <= arr[mid]){
                res = mid;
                r = mid-1;
            }else{
                l = mid+1;
            }
        }

        if(res != -1){
            return arr[res];
        }

        return res;

    }

    int findFloor(int[] arr,int n,int x){

        int l = 0;
        int r = n-1;

        int res = -1;
        while(l <= r){
            int mid = (l+r)/2;

            if(x < arr[mid]){

                r= mid-1;
            }else{
                res = mid;
                l = mid+1;
            }
        }

        if(res != -1){
            return arr[res];
        }
        return res;
    }
}
