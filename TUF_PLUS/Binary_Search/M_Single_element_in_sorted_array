# TC : O(logN)
# SC : O(1)

class Solution {
    public int singleNonDuplicate(int[] arr) {
      int n = arr.length;

      int l = 0;
      int r = n-1;

      while(l <= r){
        int mid = (l+r)/2;

        if((mid+1 == n || arr[mid+1] != arr[mid])
        && (mid-1 < 0 || arr[mid-1] != arr[mid])){
            return arr[mid];
        }

        if(mid%2 == 0){
            if(mid+1 == n || arr[mid] == arr[mid+1]){
                l = mid+1;
            }else{
                r = mid-1;
            }
        }else{
            if(mid-1 < 0 || arr[mid] == arr[mid-1]){
                l = mid+1;
            }else{
                r = mid-1;
            }
        }
      }

      return -1;
    }
}
