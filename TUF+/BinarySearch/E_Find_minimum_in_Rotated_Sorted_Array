## https://takeuforward.org/plus/dsa/problems/find-minimum-in-rotated-sorted-array?subject=dsa&approach=binary-search
# TC : O(N)(because of array conversion) otherwise O(logN)
# SC : O(N)(because of array conversion) otherwise O(1)

class Solution {
    public int findMin(ArrayList<Integer> lst) {
      int n = lst.size();
      int[] arr = lst.stream().mapToInt(Integer::intValue).toArray();

      int l = 0;
      int r = n-1;

      int min = Integer.MAX_VALUE;

      while(l <= r){

        int mid = (l+r)/2;

        if(arr[l] <= arr[mid]){
           min = Math.min(min,arr[l]);
           l = mid+1;
        }else{
           min = Math.min(min,arr[mid]);
            r = mid-1;
        }
        

      }

      return min;
    }
}
