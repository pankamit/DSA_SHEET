## https://takeuforward.org/plus/dsa/problems/best-time-to-buy-and-sell-stock-with-cooldown-and-transaction-fees?subject=dsa&approach=binary-search
# TC : O(N)
# SC : O(N)

class Solution {
    public int stockBuySell(int[] arr, int n, int fee) {

        // int[][] memo = new int[n][2];
        
        // for(int ind=0;ind<n;ind++){
        //     Arrays.fill(memo[ind],Integer.MIN_VALUE);
        // }
        
        // return tr(arr,n,fee,0,0,memo);
        return tr1(arr,n,fee); 

    }

    int tr1(int[] arr,int n,int fee){

        int[][] dp = new int[n+1][2];
        // if(l == n){
        //     return 0;
        // }

        for(int l=n-1;l>=0;l--){
            for(int canSell=1;canSell>=0;canSell--){
                    
                int max = dp[l+1][canSell];
                if(canSell == 0){
                    max = Math.max(max,-arr[l] + dp[l+1][1]);
                }else{
                    max = Math.max(max,-fee + arr[l] + dp[l+1][0]);
                }

                dp[l][canSell] = max;
            }
        }
        return dp[0][0];
    }

    int tr(int[] arr,int n,int fee,int l,int canSell,int[][] memo){

        if(l == n){
            return 0;
        }

        if(memo[l][canSell] != Integer.MIN_VALUE){
            return memo[l][canSell];
        }

        int max = tr(arr,n,fee,l+1,canSell,memo);
        if(canSell == 0){
          max = Math.max(max,-arr[l] + tr(arr,n,fee,l+1,1,memo));
        }else{
           max = Math.max(max,-fee + arr[l] + tr(arr,n,fee,l+1,0,memo));
        }

        memo[l][canSell] = max;
        return memo[l][canSell];


    }
}
