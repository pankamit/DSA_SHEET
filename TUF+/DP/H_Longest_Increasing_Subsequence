## https://takeuforward.org/plus/dsa/problems/longest-increasing-subsequence?subject=dsa&approach=binary-search
# TC : O(NlogN) 
# SC : O(N)

class Solution {
    public int LIS(int[] arr) {
        int n = arr.length;

        List<Integer> lst = new ArrayList<>();
        lst.add(arr[0]);

        for(int ind=1;ind<n;ind++){
            if(lst.get(lst.size()-1) < arr[ind]){
                lst.add(arr[ind]);
            }else{
                int pos = find(lst,arr[ind]);
                lst.set(pos,arr[ind]);
            }
        }

        return lst.size();
    }

    int find(List<Integer> lst,int x){
        int l = 0;
        int r = lst.size()-1;

        int res = -1;
        while(l <= r){
            int mid = (l+r)/2;

            if(x <= lst.get(mid)){
                res = mid;
                r = mid-1;
            }else{
                l = mid+1;
            }
        }

        return res;
    }
}

