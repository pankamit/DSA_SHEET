## https://leetcode.com/problems/stone-game-v/?envType=daily-question&envId=2026-08-17
#TC - O(N*N)
#SC- O(N*N)

class Solution {
    public int stoneGameV(int[] arr) {
        int n = arr.length;

        /*int[][] memo = new int[n][n];
        for(int i=0;i<n;i++){
            Arrays.fill(memo[i],-1);
        }

        return tr(arr,0,n-1,memo);*/

        return tr1(arr,n);
    }

    int tr1(int[] arr,int n){
        
        int[][] dp = new int[n][n]; 

        // if(l>=r){
        //     return 0;
        // }
        

        for(int l=n-1;l>=0;l--){
            for(int r=l+1;r<n;r++){
                    

                int total = 0;
                for(int ind=l;ind<=r;ind++){
                    total += arr[ind];
                }

                int max = Integer.MIN_VALUE;

                int sum1 = 0;
                int sum2 = 0;
                for(int ind=l;ind<r;ind++){
                    sum1 += arr[ind];
                    sum2 = total -sum1;
                    if(sum1 < sum2){
                        max = Math.max(max,sum1 + dp[l][ind]);
                    }else if(sum2 < sum1){
                        max = Math.max(max,sum2 + dp[ind+1][r]);
                    }else{
                        max = Math.max(max,sum1 + dp[l][ind]);
                        max = Math.max(max,sum1 + dp[ind+1][r]);
                    }

                }

                dp[l][r] = max;
            }
        }

        return dp[0][n-1];

    }

    int tr(int[] arr,int l,int r,int[][] memo){

        if(l>=r){
            return 0;
        }

        if(memo[l][r] != -1){
            return memo[l][r];
        }

        int total = 0;
        for(int ind=l;ind<=r;ind++){
            total += arr[ind];
        }

        int max = Integer.MIN_VALUE;

        int sum1 = 0;
        int sum2 = 0;
        for(int ind=l;ind<r;ind++){
            sum1 += arr[ind];
            sum2 = total -sum1;
            if(sum1 < sum2){
                max = Math.max(max,sum1 + tr(arr,l,ind,memo));
            }else if(sum2 < sum1){
                max = Math.max(max,sum2 + tr(arr,ind+1,r,memo));
            }else{
                max = Math.max(max,sum1 + tr(arr,l,ind,memo));
                max = Math.max(max,sum1 + tr(arr,ind+1,r,memo));
            }

        }

        memo[l][r] = max;
        return memo[l][r];

    }
}
