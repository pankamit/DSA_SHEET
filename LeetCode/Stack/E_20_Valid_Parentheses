## https://leetcode.com/problems/valid-parentheses/?envType=daily-question&envId=2026-10-01
# TC : O(N)
# SC : O(N)

class Solution {
    public boolean isValid(String s) {
        int n = s.length();

        Stack<Character> stack = new Stack<>();

        char[] chArr = s.toCharArray();

        for(char ch : chArr){
            if(ch == '(' || ch == '{' || ch == '['){
                stack.push(ch);
            }else{
                if(stack.isEmpty()){
                    return false;
                }
                if((ch == ')' && stack.peek() == '(') 
                || (ch == '}' && stack.peek() == '{')
                || (ch == ']' && stack.peek() == '[')){
                    stack.pop();
                }else{
                    return false;
                }
            }
        }

        return stack.isEmpty();
    }
}
