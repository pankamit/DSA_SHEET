## https://leetcode.com/problems/evaluate-the-bracket-pairs-of-a-string/?envType=daily-question&envId=2026-09-26
# TC : O(N)
# SC : O(lst.size())

class Solution {
    public String evaluate(String s, List<List<String>> lst) {
        int n = s.length();

        Map<String,String> hm = new HashMap<>();
        for(int ind=0;ind<lst.size();ind++){
            hm.put(lst.get(ind).get(0),lst.get(ind).get(1));
        }

        String res = "";
        int l = 0;
        while(l<n){
            char ch = s.charAt(l);
            if(ch >= 'a' && ch <= 'z'){
                res += ch;
            }else if(ch == '('){
                l++;
                String curr = "";
                while(l < n && s.charAt(l) != ')'){
                    curr += s.charAt(l);
                    l++;
                }
                if(hm.containsKey(curr)){
                    res += hm.get(curr);
                }else{
                    res += "?";
                }
            }
            l++;
        }

        return res;
    }
}
