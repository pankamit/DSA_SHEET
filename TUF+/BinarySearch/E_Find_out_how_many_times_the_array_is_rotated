## https://takeuforward.org/plus/dsa/problems/find-out-how-many-times-the-array-is-rotated?subject=dsa&approach=optimal
# TC : O(logN) , O(N) if we consider converting list to array
# SC : O(1) , O(N) if we consider converting list to array

class Solution {
    public int findKRotation(ArrayList<Integer> lst) {

        int[] arr = lst.stream().mapToInt(Integer::intValue).toArray();
        int n = arr.length;

        int l = 0;
        int r = n-1;

        int min = Integer.MAX_VALUE;
        int mini = -1;

        while(l<=r){

            int mid = (l+r)/2;

            // if(arr[mid] == 0){
            //     return mid;
            // }
            if(arr[l] <= arr[mid]){
                if(min > arr[l]){
                    min = arr[l];
                    mini = l;
                }
                
                l = mid+1;
                

            }else{
                if(min > arr[mid]){
                    min = arr[mid];
                    mini = mid;
                }
                r = mid-1;
            }


        }

        return mini;


    
    }
}
