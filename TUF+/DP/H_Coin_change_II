## https://takeuforward.org/plus/dsa/problems/coin-change-ii?subject=dsa&approach=recursion
# TC : O(N*total)
# SC : O(N*total)

class Solution {

    private static final int mod = 1_000_000_007;

    public int count(int[] arr, int n, int total) {

        Arrays.sort(arr);

        // int[][] memo = new int[n][total+1];
        // for(int i=0;i<n;i++){
        //     Arrays.fill(memo[i],-1);
        // } 

        // return tr(arr,n,0,total,memo);
      
        return tr1(arr,n,total);
            
    }

    int tr1(int[] arr,int n,int sum){

        int[][] dp = new int[n+1][sum+1];
        dp[n][0] = 1;

        // if(l == n){
        //     return total == 0 ? 1 : 0;
        // }


        for(int l=n-1;l>=0;l--){
            for(int total = 0;total<=sum;total++){
                
                int cnt = dp[l+1][total];
                if(arr[l] <= total){
                    cnt += dp[l][total-arr[l]];
                }

                dp[l][total] = cnt%mod;
            }
        }

        return dp[0][sum];

    }

    int tr(int[] arr,int n,int l,int total,int[][] memo){

        if(l == n){
            return total == 0 ? 1 : 0;
        }


        if(memo[l][total] != -1){
            return memo[l][total];
        }

        int cnt = tr(arr,n,l+1,total,memo);
        if(arr[l] <= total){
            cnt += tr(arr,n,l,total-arr[l],memo);
        }

        memo[l][total] = cnt%mod;
        return memo[l][total];
    }
}
